    "/admin/clients/field-values": {
      "post": {
        "summary": "Make client with fields",
        "description": "Makes new client from fields list and returns it <a href=\"#model-Client_DetailsEntity\">(Client_DetailsEntity)</a>.<br>Returns client fields list, including name, email and phone field.<br>Note: name and email are required; phone may also be required depending on company settings.<br>You can also use Client fields custom feature.<br>Throws AccessDenied error in case user does not have access to perform this action.<br>Throws BadRequest error in case invalid data was provided with detailed errors per field.<br><br>For each field in the \"fields\" array, use the field <b>name</b> (not numeric id) as the identifier.<br>For built-in fields use: \"name\", \"email\", \"phone\". For custom fields use the UUID name from GET /admin/clients/fields.<br>Example: {\"fields\": [{\"name\": \"email\", \"value\": \"user@example.com\"}, {\"name\": \"fa27a8fc098...\", \"value\": \"custom value\"}]}\n\n**Return Description:** Response data",
        "parameters": [],
        "body": {
          "required": true,
          "description": "client data",
          "content": {
            "application/json": {
              "schema": {
