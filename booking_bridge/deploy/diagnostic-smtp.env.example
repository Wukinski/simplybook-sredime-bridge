# Public metadata template. Never place the password itself here.
# Private filled copy belongs to secrets/diagnostic-smtp.env, mode 0600 owner 10001.
BRIDGE_DIAGNOSTIC_SMTP_HOST=smtp.gmail.com
BRIDGE_DIAGNOSTIC_SMTP_PORT=465
BRIDGE_DIAGNOSTIC_SMTP_USER=
BRIDGE_DIAGNOSTIC_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
BRIDGE_DIAGNOSTIC_SMTP_FROM_ADDRESS=
# Only the recipient explicitly authorized by the user is accepted by the sender.
BRIDGE_DIAGNOSTIC_SMTP_RECIPIENT=
