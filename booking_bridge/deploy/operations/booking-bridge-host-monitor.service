[Unit]
Description=Booking bridge host worker disk and backup monitoring
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/booking-bridge-operations
EnvironmentFile=/opt/booking-bridge-operations/operations.env
ExecStart=/usr/bin/docker compose -f compose.host-operations.yaml --profile operations run --rm --no-deps -T host-monitor
TimeoutStartSec=180
NoNewPrivileges=true
UMask=0077
